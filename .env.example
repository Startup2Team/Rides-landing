# Rides landing — local/staging env (copy to .env.local; never commit real values)
#
# NEXT_PUBLIC_API_URL is baked into the browser bundle at BUILD time. It must
# be the PUBLIC API URL the user's browser can reach. Used by the contact form
# and the /waitlist form.
#
# Staging:
NEXT_PUBLIC_API_URL=https://stg-api.rides.rw/api/v1
# Production (set when deploying to prod, not staging):
# NEXT_PUBLIC_API_URL=https://api.rides.rw/api/v1

# Cloudflare Turnstile site key for the public /waitlist form. Baked into the
# browser bundle at BUILD time like NEXT_PUBLIC_API_URL above. Defaults to
# Cloudflare's published always-passing TEST key if unset — swap in the real
# site key before this goes live for real traffic. The form fails open (see
# app/(pages)/waitlist/turnstile-widget.tsx) if this widget can't load, so an
# unset/wrong key degrades rather than blocking signups.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
